<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.gastossemanales.PrimaryController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <Label text="Control de Gastos Semanales">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <HBox alignment="CENTER" spacing="30.0">
            <children>
                
                <VBox spacing="8.0">
                    <children>
                        <HBox spacing="8.0">
                            <children>
                                <Label prefWidth="90.0" text="Alimentación" />
                                <TextField fx:id="txtAlimentacion" prefWidth="70.0" />
                            </children>
                        </HBox>
                        <HBox spacing="8.0">
                            <children>
                                <Label prefWidth="90.0" text="Refrigerios" />
                                <TextField fx:id="txtRefrigerios" prefWidth="70.0" />
                            </children>
                        </HBox>
                        <HBox spacing="8.0">
                            <children>
                                <Label prefWidth="90.0" text="Transporte" />
                                <TextField fx:id="txtTransporte" prefWidth="70.0" />
                            </children>
                        </HBox>
                        <HBox spacing="8.0">
                            <children>
                                <Label prefWidth="90.0" text="Telefonía" />
                                <TextField fx:id="txtTelefonia" prefWidth="70.0" />
                            </children>
                        </HBox>
                        <HBox spacing="8.0">
                            <children>
                                <Label prefWidth="90.0" text="Otros" />
                                <TextField fx:id="txtOtros" prefWidth="70.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

               
                <VBox spacing="8.0">
                    <children>
                        <Label text="Estadísticas">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Label text="Total semanal" />
                        <TextField fx:id="txtTotal" editable="false" prefWidth="120.0" />
                        
                        <Label text="Gasto más alto" />
                        <TextField fx:id="txtGastoAlto" editable="false" prefWidth="120.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnCalcular" mnemonicParsing="false" onAction="#Calcular" text="Calcular estadísticas" />
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#Limpiar" text="Limpiar" />
            </children>
        </HBox>
    </children>
</VBox>
