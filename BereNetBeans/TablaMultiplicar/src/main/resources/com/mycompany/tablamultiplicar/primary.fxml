<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tablamultiplicar.PrimaryController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <Label text="Tabla de Multiplicar">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        
        <!-- Fila de entrada de número y botones -->
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label text="Tabla del:" />
                        <TextField fx:id="txtNumero" prefWidth="60.0" />
                    </children>
                </VBox>
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Button fx:id="btnCalcular" mnemonicParsing="false" onAction="#Calcular" prefWidth="90.0" text="Calcular" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#Limpiar" prefWidth="90.0" text="Limpiar" />
                    </children>
                </VBox>
            </children>
        </HBox>
        
        <!-- Lista para mostrar la tabla -->
        <ListView fx:id="listTabla" prefHeight="200.0" prefWidth="180.0" />
    </children>
</VBox>
